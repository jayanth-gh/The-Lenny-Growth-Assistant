# Database Configuration
POSTGRES_USER=lenny_user
POSTGRES_PASSWORD=lenny_password
POSTGRES_DB=lenny_growth_db
POSTGRES_HOST=db
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://lenny_user:lenny_password@db:5432/lenny_growth_db

# LLM Providers Configuration
DEFAULT_LLM_PROVIDER=ollama
DEFAULT_LLM_MODEL=llama3.2
OLLAMA_BASE_URL=http://host.docker.internal:11434
PI_AGENT_URL=http://pi-agent:8090

# Cloud API Keys (Optional - only required if using Cloud models)
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Application Settings
ENVIRONMENT=development
LOG_LEVEL=INFO
CORS_ORIGINS=["http://localhost:3000","http://localhost:8000","http://127.0.0.1:3000"]
